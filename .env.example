# --- Spotify (optionnel : uniquement pour spotify-library / spotify-artist) ---
# https://developer.spotify.com/dashboard  (le propriétaire de l'app doit avoir Spotify Premium depuis 2026)
SPOTIPY_CLIENT_ID="your_spotify_client_id"
SPOTIPY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIPY_REDIRECT_URI="http://127.0.0.1:8080/callback"

# --- Téléchargement ---
DOWNLOAD_DIR="downloads"      # dossier des MP3, ex. "D:\Musique" ou "~/Music" (relatif = dans le dossier du projet)
DATA_DIR="data"               # listes de morceaux (JSON), échecs (failed_*.json) et journal
CONCURRENT_DOWNLOADS=3
RATE_LIMIT_DELAY=2.0          # pause (s) après chaque téléchargement, par worker
MP3_QUALITY=0                 # 0 = VBR V0 (~245 kbps, recommandé) ; 320 = CBR 320 kbps
MATCH_THRESHOLD=0.72          # score minimal (0-1) pour accepter un résultat YouTube Music

# --- Métadonnées ---
ID3_VERSION=3                 # 3 = compatibilité max (Explorateur Windows, autoradios) ; 4 = multi-valeurs natives
COVER_SIZE=1200               # pochettes Cover Art Archive : 250, 500, 1200 ou full
SAVE_FOLDER_COVER=true        # cover.jpg dans chaque dossier d'album
FETCH_LYRICS=true             # paroles via LRCLIB (gratuit, sans compte)
SAVE_LRC=true                 # paroles synchronisées en .lrc à côté du .mp3
MUSICBRAINZ_CONTACT=""        # e-mail ou URL de contact demandé par MusicBrainz (recommandé)
PREFERRED_COUNTRIES="XW,FR,XE,US,GB"  # pays préférés pour choisir l'édition d'un album
